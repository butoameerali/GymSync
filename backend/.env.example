# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB (Authentication & Identity Store: _id, email, password, role)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/gymsync?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key

# Supabase (Heavy Data & Media Storage: Posts, Exercises, User Records, Media Buckets)
# Retrieve these from your Supabase Project Settings -> API & Storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_STORAGE_BUCKET=gymsync-media

# Stripe Payment Gateway
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Google OAuth & Gmail Verification
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
ENABLE_OLLAMA=true
# For Local machine: http://localhost:11434/api/chat
# For Google Colab (Cloudflare Tunnel): https://xxxx.trycloudflare.com
# For Google Colab (Ngrok Tunnel): https://xxxx.ngrok-free.app
OLLAMA_HOST=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=60000
# On Colab T4 GPU (16GB VRAM), 2048 or 4096 context runs lightning fast:
OLLAMA_NUM_CTX=2048

