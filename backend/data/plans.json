Mesocycles": [{"Fitness Goal": "Muscle Building (Hypertrophy)", "Timeline": "Week 1", "Phase Name": "Base Volume Phase", "Training Directives (Reps/Sets/Volume)": "3 sets of 10-12 reps. Focus on form and mind-muscle connection. Moderate weights.", "Objective": "Establish baseline safely."}, {"Fitness Goal": "Muscle Building (Hypertrophy)", "Timeline": "Week 2", "Phase Name": "Progressive Overload", "Training Directives (Reps/Sets/Volume)": "3 sets of 8-10 reps. Increase weight by 5-10% from Week 1. Push closer to failure.", "Objective": "Trigger muscle growth adaptation."}, {"Fitness Goal": "Muscle Building (Hypertrophy)", "Timeline": "Week 3", "Phase Name": "Peak Intensity", "Training Directives (Reps/Sets/Volume)": "4 sets of 8 reps. Heaviest weight of the month. Add one drop-set on the last exercise.", "Objective": "Maximum muscle stimulation."}, {"Fitness Goal": "Muscle Building (Hypertrophy)", "Timeline": "Week 4", "Phase Name": "Deload / Active Recovery", "Training Directives (Reps/Sets/Volume)": "2 sets of 12-15 reps with 50% of the weight used in Week 3. Focus on stretch.", "Objective": "CNS recovery and muscle repair."}, {"Fitness Goal": "Weight Loss / Fat Burn", "Timeline": "Week 1", "Phase Name": "Conditioning Start", "Training Directives (Reps/Sets/Volume)": "30 mins total workout. 15 mins steady state cardio + light circuit training.", "Objective": "Build aerobic base."}, {"Fitness Goal": "Weight Loss / Fat Burn", "Timeline": "Week 2", "Phase Name": "Intensity Bump", "Training Directives (Reps/Sets/Volume)": "40 mins total. Introduce 10 mins of HIIT (High Intensity Interval Training) + weights.", "Objective": "Increase calorie burn rate."}, {"Fitness Goal": "Weight Loss / Fat Burn", "Timeline": "Week 3", "Phase Name": "Max Fat Burn", "Training Directives (Reps/Sets/Volume)": "45 mins total. 15 mins HIIT + Heavy compound movements to preserve muscle.", "Objective": "Maximize EPOC (afterburn effect)."}, {"Fitness Goal": "Weight Loss / Fat Burn", "Timeline": "Week 4", "Phase Name": "Recovery & Reassess", "Training Directives (Reps/Sets/Volume)": "Steady state cardio only + Yoga/Mobility. Weigh-in and check measurements.", "Objective": "Joint recovery and stress reduction."}], "Yearly_Macrocycles": [{"Fitness Path": "General Fitness & Recomposition", "Timeline": "Months 1-3", "Phase Name": "Anatomical Adaptation (Foundation)", "Programming Rules": "Basic Full Body splits. Focus on learning exercise mechanics, building a habit, and fixing posture. Light to moderate weights.", "Long-Term Objective": "Prepare joints, tendons, and ligaments for future heavy loads."}, {"Fitness Path": "General Fitness & Recomposition", "Timeline": "Months 4-6", "Phase Name": "Hypertrophy (Muscle Building)", "Programming Rules": "Switch to Upper/Lower split. Increase volume (more sets/reps). Caloric intake is slightly increased or maintained.", "Long-Term Objective": "Build lean muscle mass to increase metabolic rate."}, {"Fitness Path": "General Fitness & Recomposition", "Timeline": "Months 7-9", "Phase Name": "Strength Block", "Programming Rules": "Lower reps (4-6), heavier weights. Focus on compound lifts (Squat, Deadlift, Press). Longer rest periods.", "Long-Term Objective": "Increase raw physical strength and central nervous system efficiency."}, {"Fitness Path": "General Fitness & Recomposition", "Timeline": "Months 10-11", "Phase Name": "Fat Loss / Shredding Phase", "Programming Rules": "High-intensity circuits, reduced rest times, increased cardio. Caloric deficit diet implemented.", "Long-Term Objective": "Strip away body fat to reveal the muscle built in previous phases."}, {"Fitness Path": "General Fitness & Recomposition", "Timeline": "Month 12", "Phase Name": "Active Rest & Maintenance", "Programming Rules": "Fun activities, sports, swimming, light gym maintenance twice a week.", "Long-Term Objective": "Mental break from strict routine, physical reset for the next year."}]}